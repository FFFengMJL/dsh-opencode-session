{
  "name": "dsh-opencode-session",
  "version": "0.2.2",
  "private": true,
  "description": "Per-DSH-session x-opencode-session header injection for custom OpenCode Go routes, via the llm-pi-ai/request-headers waterfall.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check:syntax": "node --check lib/index.js",
    "test": "node --test test/session.test.mjs test/lifecycle.test.mjs",
    "package:check": "node scripts/check-package.mjs",
    "release:pack": "node scripts/create-release-package.mjs",
    "verify": "pnpm check:syntax && pnpm test && pnpm package:check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FFFengMJL/dsh-opencode-session.git"
  },
  "homepage": "https://github.com/FFFengMJL/dsh-opencode-session#readme",
  "bugs": {
    "url": "https://github.com/FFFengMJL/dsh-opencode-session/issues"
  },
  "author": "FFFengMJL",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "license": "MIT"
}
